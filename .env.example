# Background removal provider (no API key needed for "birefnet" or "local"):
#   "birefnet" - higher accuracy, ~224MB model download, ~10-15s per image
#   "local"    - faster/lighter, ~88MB model, lower accuracy on hands/hair
#   "removebg" | "replicate" - hosted, need an API key, fastest + most accurate
BACKGROUND_REMOVAL_PROVIDER=birefnet

# remove.bg API key (https://www.remove.bg/api)
REMOVEBG_API_KEY=your_api_key_here

# Replicate API token (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=your_token_here

# Max upload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800
